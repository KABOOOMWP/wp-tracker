root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
max_line_length = 140
# ktlint: the IntelliJ Kotlin style (kotlin.code.style=official); Compose functions are PascalCase
ktlint_code_style = intellij_idea
ktlint_function_naming_ignore_when_annotated_with = Composable

[*.swift]
max_line_length = 160

[*.py]
max_line_length = 140

[*.{json,yml,yaml,html}]
indent_size = 2

# Xcode writes these with tabs
[*.{pbxproj,plist,xcscheme}]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
